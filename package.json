{
  "private": true,
  "description": "Oh! Markdown~ parse and recompile markdown for render by js, support jsx, dom-tree or html",
  "scripts": {
    "clean": "pnpm -r run clean",
    "build": "pnpm -r run build",
    "test:unit": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:type": "pnpm -r run test:type && tsc --noEmit -p __tests__/tsconfig.json",
    "test": "pnpm build && pnpm test:type && pnpm test:unit",
    "prepare": "husky install",
    "release": "pnpm test && changeset version && changeset publish"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yeliex/oh-markdown/issues"
  },
  "homepage": "https://github.com/yeliex/oh-markdown#readme",
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@mdx-js/react": "^2.2.1",
    "@oh-markdown/react": "workspace:*",
    "@swc/core": "^1.3.30",
    "@swc/jest": "^0.2.24",
    "@types/jest": "^29.4.0",
    "@types/lodash.camelcase": "^4.3.9",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/lodash.set": "^4.3.9",
    "@types/node": "^18.11.13",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.9",
    "husky": "^8.0.3",
    "jest": "^29.4.1",
    "oh-markdown": "workspace:*",
    "pkgroll": "^2.28.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest-resolver": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.3.4"
}
